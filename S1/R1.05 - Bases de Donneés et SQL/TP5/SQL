--Q1-----------------------------------------
SELECT désignation 
FROM PRODUIT 
WHERE idProduit NOT IN (
    SELECT DISTINCT idProduit 
    FROM VENTE v 
    JOIN FACTURE f ON v.idFacture = f.idFacture 
    WHERE YEAR(f.dateFacture) = 2020
);


SELECT p.désignation 
FROM PRODUIT p 
LEFT JOIN VENTE v ON p.idProduit = v.idProduit 
LEFT JOIN FACTURE f ON v.idFacture = f.idFacture AND YEAR(f.dateFacture) = 2020 
WHERE f.idFacture IS NULL;


SELECT désignation 
FROM PRODUIT p 
WHERE NOT EXISTS (
    SELECT 1 
    FROM VENTE v 
    JOIN FACTURE f ON v.idFacture = f.idFacture 
    WHERE p.idProduit = v.idProduit 
    AND YEAR(f.dateFacture) = 2020
);


--Q2--------------
SELECT c.nom, p.désignation, v.quantité, p.prix 
FROM CLIENT c 
JOIN FACTURE f ON c.idClient = f.idClient 
JOIN VENTE v ON f.idFacture = v.idFacture 
JOIN PRODUIT p ON v.idProduit = p.idProduit 
WHERE c.ville = 'Paris';


--Q3------------------
SELECT SUM(v.quantité * p.prix) AS total_depenses 
FROM CLIENT c 
JOIN FACTURE f ON c.idClient = f.idClient 
JOIN VENTE v ON f.idFacture = v.idFacture 
JOIN PRODUIT p ON v.idProduit = p.idProduit 
WHERE c.ville = 'Paris';


--Q4-------
SELECT c.ville, SUM(v.quantité * p.prix) AS total_depenses 
FROM CLIENT c 
JOIN FACTURE f ON c.idClient = f.idClient 
JOIN VENTE v ON f.idFacture = v.idFacture 
JOIN PRODUIT p ON v.idProduit = p.idProduit 
GROUP BY c.ville;

--Q5-----
SELECT p.désignation, SUM(v.quantité) AS total_vendus 
FROM PRODUIT p 
JOIN VENTE v ON p.idProduit = v.idProduit 
JOIN FACTURE f ON v.idFacture = f.idFacture 
WHERE f.dateFacture < '2021-01-01' 
GROUP BY p.désignation;



--Q6--------
SELECT p.désignation, SUM(v.quantité * p.prix) AS chiffre_affaires 
FROM PRODUIT p 
JOIN VENTE v ON p.idProduit = v.idProduit 
JOIN FACTURE f ON v.idFacture = f.idFacture 
WHERE f.dateFacture BETWEEN '2020-01-01' AND '2021-12-31' 
GROUP BY p.désignation 
ORDER BY chiffre_affaires DESC, p.désignation ASC;


