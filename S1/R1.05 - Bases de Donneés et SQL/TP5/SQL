CREATE TABLE CLIENT(idClient INT PRIMARY KEY,nom VARCHAR(50),ville VARCHAR(50))
CREATE TABLE PRODUIT(idProduit VARCHAR(50) PRIMARY KEY, désignation VARCHAR(50), prix INT)
CREATE TABLE FACTURE(idFacture INT PRIMARY KEY, datefacture DATE, idClient INT FOREIGN KEY REFERENCES CLIENT(idClient) NOT NULL)
CREATE TABLE VENTE(idFacture INT FOREIGN KEY REFERENCES FACTURE(idFacture), idProduit VARCHAR(50) FOREIGN KEY REFERENCES PRODUIT(idProduit),quantité INT)


