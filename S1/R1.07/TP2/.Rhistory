temp <- matriceA[ligne1, ]
matriceA[ligne1, ] <- matriceA[ligne2, ]
matriceA[ligne2, ] <- temp
return(matriceA)
}
matriceA <- creationMatrice(c(6,-1,1,0,-3,1,1,-2,1),nbLignes = 3, nbColonnes = 3)
