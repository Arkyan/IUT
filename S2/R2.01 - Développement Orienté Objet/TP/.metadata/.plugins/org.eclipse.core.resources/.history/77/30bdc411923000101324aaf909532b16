package unilim.info.ihm.tp6.exo3.view;

import javafx.scene.image.ImageView;
import unilim.info.ihm.tp6.exo3.model.Card;

public class CardImageView extends ImageView {
	
	private static Card card;
	private static final String IMAGE_PATH = "/unilim/info/ihm/tp6/exo3/view/";
	private ImageView imageViewcard;
	
	public CardImageView(Card card) {
		if (card == null) {
			throw new IllegalArgumentException("La carte ne peut pas être nulle");
		}
		
		this.card = card;
		this.imageViewcard = new ImageView(IMAGE_PATH + card.getValue() + ".png");
		
	}
	

}
