package unilim.info.ihm.tp6.exo3.controller;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.image.ImageView;
import javafx.scene.input.ClipboardContent;
import javafx.scene.input.Dragboard;
import javafx.scene.input.TransferMode;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Pane;
import unilim.info.ihm.tp6.exo3.model.Card;
import unilim.info.ihm.tp6.exo3.tools.CardGameTools;
import unilim.info.ihm.tp6.exo3.view.CardImageView;

public class WarCardGameController {

    @FXML
    private Button idBtnChanger;

    @FXML
    private Button idBtnQuitter;

    @FXML
    private Pane idCardToBeat;
    
    @FXML
    private ImageView card1View, card2View, card3View, card4View, card5View;
    
    @FXML
    private ImageView cardToBeatView;

    @FXML
    private HBox idDeck;

    @FXML
    void changer(ActionEvent event) {
        CardImageView card1 = new CardImageView(new Card(CardGameTools.generateCardValue()));
        CardImageView card2 = new CardImageView(new Card(CardGameTools.generateCardValue()));
        CardImageView card3 = new CardImageView(new Card(CardGameTools.generateCardValue()));
        CardImageView card4 = new CardImageView(new Card(CardGameTools.generateCardValue()));
        CardImageView card5 = new CardImageView(new Card(CardGameTools.generateCardValue()));
        CardImageView cardToBeat = new CardImageView(new Card(CardGameTools.generateCardValue()));

        // Ajout des cartes dans le deck
        idDeck.getChildren().addAll(card1, card2, card3, card4, card5);

        // Carte à battre
        idCardToBeat.getChildren().add(cardToBeat);

        // Activation du DnD pour chaque carte source
        manageSourceDnD(card1, idDeck);
        manageSourceDnD(card2, idDeck);
        manageSourceDnD(card3, idDeck);
        manageSourceDnD(card4, idDeck);
        manageSourceDnD(card5, idDeck);

        // Activation du DnD pour la cible
        manageTargetDnD(cardToBeat, idCardToBeat);
    }

    @FXML
    void quitter(ActionEvent event) {
        System.exit(0);
    }
    
    @FXML
    void initialize() {
        changer(null);
    }
    
    public static void manageSourceDnD(CardImageView source, HBox deck) {
    	source.setOnDragDetected(event -> {
    		System.out.println("Drag detected on " + source.getCard().getValue());
            var db = source.startDragAndDrop(TransferMode.MOVE);
            var content = new ClipboardContent();

            content.putImage(source.getImage());
            db.setContent(content);
            
            event.consume();
        });

        source.setOnDragDone(event -> {
            if (event.getTransferMode() == TransferMode.MOVE) {
                deck.getChildren().remove(source);
            }
            event.consume();
        });
	}
    
    public static void manageTargetDnD(CardImageView target, Pane container) {
    	container.setOnDragOver(event -> {
            if (event.getGestureSource() != container && event.getDragboard().hasImage()) {
                event.acceptTransferModes(TransferMode.MOVE);
            }
            event.consume();
        });

        container.setOnDragDropped(event -> {
            Dragboard db = event.getDragboard();
            boolean success = false;

            if (db.hasImage()) {
                target.setImage(db.getImage());

                if (!container.getChildren().contains(target)) {
                    container.getChildren().clear(); 
                    container.getChildren().add(target);
                }
                success = true;
            }

            event.setDropCompleted(success);
            event.consume();
        });
    }
    
}