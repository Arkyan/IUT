package unilim.info.ihm.tp6.exo3.controller;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.image.ImageView;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Pane;
import unilim.info.ihm.tp6.exo3.model.Card;
import unilim.info.ihm.tp6.exo3.tools.CardGameTools;
import unilim.info.ihm.tp6.exo3.view.CardImageView;

public class WarCardGameController {

    @FXML
    private Button idBtnChanger;

    @FXML
    private Button idBtnQuitter;

    @FXML
    private Pane idCardToBeat;
    
    @FXML
    private ImageView card1View, card2View, card3View, card4View, card5View;
    
    @FXML
    private ImageView cardToBeatView;

    @FXML
    private HBox idDeck;

    @FXML
    void changer(ActionEvent event) {
        Integer card1 = CardGameTools.generateCardValue();
		Integer card2 = CardGameTools.generateCardValue();
		Integer card3 = CardGameTools.generateCardValue();
		Integer card4 = CardGameTools.generateCardValue();
		Integer card5 = CardGameTools.generateCardValue();

		card1View.setImage(CardGameTools.loadCardImage(card1).getImage());
		card2View.setImage(CardGameTools.loadCardImage(card2).getImage());
		card3View.setImage(CardGameTools.loadCardImage(card3).getImage());
		card4View.setImage(CardGameTools.loadCardImage(card4).getImage());
		card5View.setImage(CardGameTools.loadCardImage(card5).getImage());
    }

    @FXML
    void quitter(ActionEvent event) {
        System.exit(0);
    }
    
    @FXML
    void initialize() {
        Card card1 = new Card(CardGameTools.generateCardValue());
        Card card2 = new Card(CardGameTools.generateCardValue());
        Card card3 = new Card(CardGameTools.generateCardValue());
        Card card4 = new Card(CardGameTools.generateCardValue());
        Card card5 = new Card(CardGameTools.generateCardValue());
        
        CardImageView card1View = new CardImageView(card1);
        CardImageView card2View = new CardImageView(card2);
        CardImageView card3View = new CardImageView(card3);
        CardImageView card4View = new CardImageView(card4);
        CardImageView card5View = new CardImageView(card5);

        idDeck.getChildren().addAll(card1View, card2View, card3View, card4View, card5View);
    	
        
    }
    

}