package unilim.info.ihm.tp6.exo3.controller;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.control.Label;
import javafx.scene.image.ImageView;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Pane;
import unilim.info.ihm.tp6.exo3.tools.CardGameTools;
import unilim.info.ihm.tp6.exo3.view.CardImageView;
import javafx.scene.input.TransferMode;


public class WarCardGameController {
	@FXML
	public CardImageView card1;
	@FXML public CardImageView card2;
	@FXML public CardImageView card3;
	@FXML public CardImageView card4;
	@FXML public CardImageView card5;
	@FXML public CardImageView cardToBeat;

    @FXML
    private Button idBtnChanger;

    @FXML
    private Button idBtnQuitter;

    @FXML
    private Pane idCardToBeat;

    @FXML
	public HBox idDeck;

    @FXML
    void changer(ActionEvent event) {
        Integer cardValue1 = CardGameTools.generateCardValue();
    	Integer cardValue2 = CardGameTools.generateCardValue();
    	Integer cardValue3 = CardGameTools.generateCardValue();	
    	Integer cardValue4 = CardGameTools.generateCardValue();
    	Integer cardValue5 = CardGameTools.generateCardValue();
    	
    	this.card1.setImage(CardGameTools.loadCardImage(cardValue1).getImage());
    	this.card2.setImage(CardGameTools.loadCardImage(cardValue2).getImage());
    	this.card3.setImage(CardGameTools.loadCardImage(cardValue3).getImage());
    	this.card4.setImage(CardGameTools.loadCardImage(cardValue4).getImage());
    	this.card5.setImage(CardGameTools.loadCardImage(cardValue5).getImage());
    }

    @FXML
    void quitter(ActionEvent event) {
        System.exit(0);
    }
    
    @FXML
    void initialize() {
        Integer cardValue1 = CardGameTools.generateCardValue();
        Integer cardValue2 = CardGameTools.generateCardValue();
        Integer cardValue3 = CardGameTools.generateCardValue();
        Integer cardValue4 = CardGameTools.generateCardValue();
        Integer cardValue5 = CardGameTools.generateCardValue();
        Integer cardToBeatValue = CardGameTools.generateCardValue();

        this.card1.setImage(CardGameTools.loadCardImage(cardValue1).getImage());
        this.card2.setImage(CardGameTools.loadCardImage(cardValue2).getImage());
        this.card3.setImage(CardGameTools.loadCardImage(cardValue3).getImage());
        this.card4.setImage(CardGameTools.loadCardImage(cardValue4).getImage());
        this.card5.setImage(CardGameTools.loadCardImage(cardValue5).getImage());
        
        this.cardToBeat.setImage(CardGameTools.loadCardImage(cardToBeatValue).getImage());
    }

    
    public static void manageSourceDnD(CardImageView source, HBox deck) {
        CardImageView card = new CardImageView(source.getCard());

        card.setOnDragDetected(event -> {
            card.startFullDrag();
        });

        card.setOnDragOver(event -> {
            if (event.getGestureSource() != card && event.getDragboard().hasImage()) {
                event.acceptTransferModes(TransferMode.COPY);
            }
            event.consume();
        });

        card.setOnDragDropped(event -> {
            if (event.getGestureSource() != card && event.getDragboard().hasImage()) {
                deck.getChildren().add(card);
                event.setDropCompleted(true);
            } else {
                event.setDropCompleted(false);
            }
            event.consume();
        });
    }
    
    public static void manageTargetDnD(CardImageView target, HBox deck) {
        target.setOnDragOver(event -> {
            if (event.getGestureSource() != target && event.getDragboard().hasImage()) {
                event.acceptTransferModes(TransferMode.COPY);
            }
            event.consume();
        });

        target.setOnDragDropped(event -> {
            if (event.getGestureSource() != target && event.getDragboard().hasImage()) {
                deck.getChildren().add(target);
                event.setDropCompleted(true);
            } else {
                event.setDropCompleted(false);
            }
            event.consume();
        });
    }

    
}