package unilim.info.ihm.tp6.exo3.controller;

import javafx.event.ActionEvent;
import javafx.fxml.FXML;
import javafx.scene.control.Button;
import javafx.scene.image.ImageView;
import javafx.scene.input.ClipboardContent;
import javafx.scene.input.Dragboard;
import javafx.scene.input.TransferMode;
import javafx.scene.layout.HBox;
import javafx.scene.layout.Pane;
import unilim.info.ihm.tp6.exo3.model.Card;
import unilim.info.ihm.tp6.exo3.tools.CardGameTools;
import unilim.info.ihm.tp6.exo3.view.CardImageView;

public class WarCardGameController {

    @FXML
    private Button idBtnChanger;

    @FXML
    private Button idBtnQuitter;

    @FXML
    private Pane idCardToBeat;
    
    @FXML
    private ImageView card1View, card2View, card3View, card4View, card5View;
    
    @FXML
    private ImageView cardToBeatView;

    @FXML
    private HBox idDeck;

    @FXML
    void changer(ActionEvent event) {
    	Card card1 = new Card(CardGameTools.generateCardValue());
        Card card2 = new Card(CardGameTools.generateCardValue());
        Card card3 = new Card(CardGameTools.generateCardValue());
        Card card4 = new Card(CardGameTools.generateCardValue());
        Card card5 = new Card(CardGameTools.generateCardValue());
        Card cardToBeat = new Card(CardGameTools.generateCardValue());

        card1View.setImage(new CardImageView(card1).getImage());
        card2View.setImage(new CardImageView(card2).getImage());
        card3View.setImage(new CardImageView(card3).getImage());
        card4View.setImage(new CardImageView(card4).getImage());
        card5View.setImage(new CardImageView(card5).getImage());
        cardToBeatView.setImage(new CardImageView(cardToBeat).getImage());

        manageSourceDnD(card1View, idDeck);
        manageSourceDnD(card2View, idDeck);
        manageSourceDnD(card3View, idDeck);
        manageSourceDnD(card4View, idDeck);
        manageSourceDnD(card5View, idDeck);

        manageTargetDnD(cardToBeatView, idCardToBeat);
    }

    @FXML
    void quitter(ActionEvent event) {
        System.exit(0);
    }
    
    @FXML
    void initialize() {
        changer(null);
    }
    
    public static void manageSourceDnD(ImageView source, HBox container) {
        source.setOnDragDetected(event -> {
            Dragboard db = source.startDragAndDrop(TransferMode.MOVE);
            ClipboardContent content = new ClipboardContent();

            // On récupère la Card liée à l'image, ici il faut un moyen de retrouver la Card.
            // Vu que tu utilises CardImageView, idéalement tu utilises CardImageView directement comme source.
            // Mais ici, tu as un ImageView pur, donc il faudrait stocker la Card quelque part (ex: Map<Image, Card>),
            // ou bien remplacer ImageView par CardImageView dans ton controller.

            // Pour l'exemple, supposons que source est en fait un CardImageView (extends ImageView) avec une méthode getCard()
            if (source instanceof CardImageView) {
                Card card = ((CardImageView) source).getCard();
                content.putImage(source.getImage());
                content.putString(String.valueOf(card.getValue())); // transport de la valeur en String
            } else {
                // Si ce n'est pas un CardImageView, juste transporter l'image (moins idéal)
                content.putImage(source.getImage());
                // Pas de valeur transportée, donc pas de comparaison possible
            }

            db.setContent(content);
            event.consume();
        });

        source.setOnDragDone(event -> {
            if (event.getTransferMode() == TransferMode.MOVE) {
                source.setImage(null);
            }
            event.consume();
        });
    }

   
    public static void manageTargetDnD(ImageView target, Pane container) {
        container.setOnDragOver(event -> {
            if (event.getGestureSource() != container && event.getDragboard().hasImage() && event.getDragboard().hasString()) {
                // Vérification possible car on a la valeur dans la string
                event.acceptTransferModes(TransferMode.MOVE);
            }
            event.consume();
        });

        container.setOnDragDropped(event -> {
            Dragboard db = event.getDragboard();
            boolean success = false;

            if (db.hasImage() && db.hasString()) {
                int draggedValue = Integer.parseInt(db.getString());

                // Récupérer la valeur de la carte à battre
                Card cardToBeat = null;

                if (target instanceof CardImageView) {
                    cardToBeat = ((CardImageView) target).getCard();
                } else {
                    // Si target est un ImageView standard, il faut une autre façon de récupérer la valeur.
                    // Ici, on suppose que le target est un CardImageView.
                }

                if (cardToBeat == null || draggedValue > cardToBeat.getValue()) {
                    // Si la valeur dragée est plus grande, accepter le drop
                    target.setImage(db.getImage());

                    if (!container.getChildren().contains(target)) {
                        container.getChildren().clear();
                        container.getChildren().add(target);
                    }
                    success = true;
                } else {
                    // Sinon, on refuse le drop, peut-être afficher un message ou un effet visuel
                    System.out.println("Carte trop faible, impossible de déposer.");
                }
            }

            event.setDropCompleted(success);
            event.consume();
        });
    }

}