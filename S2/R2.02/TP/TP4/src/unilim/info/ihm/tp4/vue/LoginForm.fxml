<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="170.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="unilim.info.ihm.tp4.controlleur.LoginFormController">
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <top>
      <Label text="Veuillez saisir vos informations de login" BorderPane.alignment="CENTER" />
   </top>
   <left>
      <Label fx:id="idLibErr" maxWidth="250.0" minWidth="250.0" text="En cas d'erreur" BorderPane.alignment="CENTER" />
   </left>
   <center>
      <GridPane BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
          <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label alignment="CENTER" text="Utilisateur : " GridPane.halignment="CENTER" GridPane.valignment="CENTER" />
            <Label text="Mot de passe : " GridPane.halignment="CENTER" GridPane.rowIndex="1" GridPane.valignment="CENTER" />
            <Label text="Application : " GridPane.halignment="CENTER" GridPane.rowIndex="2" GridPane.valignment="CENTER" />
            <TextField fx:id="idUser" GridPane.columnIndex="1" />
            <PasswordField fx:id="idPwd" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <ComboBox fx:id="idCb" prefWidth="150.0" GridPane.columnIndex="1" GridPane.rowIndex="2" />
         </children>
      </GridPane>
   </center>
   <right>
      <Button fx:id="idBtnValider" mnemonicParsing="false" onAction="#validerSaisies" text="Valider" BorderPane.alignment="CENTER">
         <BorderPane.margin>
            <Insets left="10.0" right="10.0" />
         </BorderPane.margin></Button>
   </right>
   <bottom>
      <Label fx:id="idLibBas" text=" login de &lt;xxx&gt; pour application &lt;xxx&gt; le xx/xx" BorderPane.alignment="CENTER" />
   </bottom>
</BorderPane>
